# --- Database ---
# Hosted (Neon/Render): set DATABASE_URL; it takes priority over the DB_* settings.
DATABASE_URL=
# Local PostgreSQL:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=notesharing

PORT=5000
# Set to "production" when deployed (enables secure cross-site session cookies).
NODE_ENV=development

# Optional OpenAI-compatible AI provider. AI features report an explicit setup error if absent.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
# Optional: used when AI_MODEL stays overloaded (HTTP 503) after retries.
AI_FALLBACK_MODEL=

SESSION_SECRET=replace-with-a-long-random-secret
# Comma-separated frontend URLs allowed to call the API (add your Vercel URL when deployed).
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
